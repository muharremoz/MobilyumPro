// MobilyumPro veritabanı şeması (SQL Server + Prisma).
// Alan adları uygulamadaki domain modeliyle (Türkçe) birebir tutulur.
// ID'ler insan-okunur kodlar (URN-1001, MLZ-1001 ...).
//
// Not: SQL Server'da Postgres'teki enum/array/jsonb yok:
//  - enum'lar   → String (uygulama katmanı domain tipleriyle daraltır)
//  - text[]     → JSON string (gorsellerJson)
//  - jsonb      → JSON string (varyantlarJson)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── Parça (BOM kataloğu — kullanıcıya "Reçete" olarak sunulur) ──────────
model Parca {
  id       String  @id
  ad       String
  kategori String
  aciklama String? @db.NVarChar(Max)
  durum    String  @default("Aktif")

  recete       ReceteSatiri[]   @relation("ParcaRecete")
  altParcaOlan ReceteSatiri[]   @relation("AltParca")
  modeller     ModelParca[]
  versiyonlar  ReceteVersiyon[]

  @@map("parca")
}

// ── Reçete versiyonu (her kayıtta anlık kopya; tam geçmiş) ──────────────
model ReceteVersiyon {
  id           Int      @id @default(autoincrement())
  parcaId      String   @map("parca_id")
  versiyonNo   Int      @map("versiyon_no")
  tarih        DateTime @default(now())
  aciklama     String?  @db.NVarChar(Max)
  // Satırların anlık kopyası: [{tip, ref, miktar}] (JSON)
  satirlarJson String   @map("satirlar") @db.NVarChar(Max)

  parca Parca @relation(fields: [parcaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parcaId, versiyonNo])
  @@map("recete_versiyon")
}

// ── Reçete satırı (parçanın bileşenleri: malzeme veya alt-parça) ────────
model ReceteSatiri {
  id         Int     @id @default(autoincrement())
  parcaId    String  @map("parca_id")
  tip        String
  malzemeId  String? @map("malzeme_id")
  altParcaId String? @map("alt_parca_id")
  miktar     Decimal @db.Decimal(14, 3)
  // Fire payı (%): brüt ihtiyaç = miktar × (1 + fire/100)
  fire       Decimal @default(0) @db.Decimal(5, 2)
  // Bileşenin tüketildiği istasyon (fabrika rotası slug'ı; null → ilk istasyon)
  istasyon   String?

  parca    Parca  @relation("ParcaRecete", fields: [parcaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  stok     Stok?  @relation(fields: [malzemeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  altParca Parca? @relation("AltParca", fields: [altParcaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("recete_satiri")
}

// ── Model-Parça (modelin BOM bağlantısı) ────────────────────────────────
model ModelParca {
  id      Int     @id @default(autoincrement())
  modelId String  @map("model_id")
  parcaId String  @map("parca_id")
  miktar  Decimal @db.Decimal(14, 3)

  stok  Stok  @relation(fields: [modelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parca Parca @relation(fields: [parcaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("model_parca")
}

// ── Depo ────────────────────────────────────────────────────────────────
model Depo {
  id       String @id
  ad       String
  sehir    String
  kapasite Int    @default(0)
  doluluk  Int    @default(0)
  durum    String @default("Aktif")

  @@map("depo")
}

// ── Müşteri ─────────────────────────────────────────────────────────────
model Musteri {
  id    String  @id
  ad    String
  email String?
  sehir String?

  siparisler Siparis[]

  @@map("musteri")
}

// ── Sipariş ─────────────────────────────────────────────────────────────
model Siparis {
  id        String   @id
  musteriId String?  @map("musteri_id")
  musteriAd String   @map("musteri_ad") // anlık ad (görüntü/tarihsel)
  tarih     DateTime @db.Date
  tutar     Decimal  @default(0) @db.Decimal(14, 2)
  durum     String   @default("Beklemede")
  urunAdedi Int      @default(1) @map("urun_adedi")

  musteri Musteri? @relation(fields: [musteriId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("siparis")
}

// ── Üretim emri ─────────────────────────────────────────────────────────
model UretimEmri {
  id            String    @id
  modelId       String    @map("model_id")
  modelAd       String    @map("model_ad")
  adet          Int       @default(1)
  durum         String    @default("Planlandı")
  oncelik       String?   @default("Normal")
  olusturma     DateTime  @db.Date
  termin        DateTime? @db.Date
  kaynakSiparis String?   @map("kaynak_siparis")
  musteri       String?
  hedefDepo     String?   @map("hedef_depo")
  not           String?   @db.NVarChar(Max)

  stok    Stok             @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adimlar UretimEmriAdim[]

  @@map("uretim_emri")
}

// ── Üretim emri adımı (fabrika istasyon rotası) ─────────────────────────
model UretimEmriAdim {
  id        Int       @id @default(autoincrement())
  emirId    String    @map("emir_id")
  // İstasyon slug'ı: kesim | bantlama | delik | montaj | paketleme | sevkiyat
  istasyon  String
  sira      Int
  // "Bekliyor" | "İşleniyor" | "Tamamlandı"
  durum     String    @default("Bekliyor")
  baslangic DateTime?
  bitis     DateTime?

  emir UretimEmri @relation(fields: [emirId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([emirId, sira])
  @@map("uretim_emri_adim")
}

// ── Cari (müşteri/tedarikçi hesabı) ─────────────────────────────────────
model Cari {
  id             String   @id
  // Kısa ad (listede görünen)
  ad             String
  // Tam ad / ticari ad
  tamAd          String?  @map("tam_ad")
  tip            String
  sinif          String
  // Ana yetkili kişi (hızlı erişim; detaylı liste CariYetkili'de)
  yetkili        String?
  yetkiliUnvan   String?  @map("yetkili_unvan")
  yetkiliTelefon String?  @map("yetkili_telefon")
  yetkiliEmail   String?  @map("yetkili_email")
  telefon        String?
  telefon2       String?
  telefon3       String?
  fax            String?
  email          String?
  webSite        String?  @map("web_site")
  // "Maliyet" | "Satış Fiyatı 1" | "Satış Fiyatı 2"
  satisFiyatTipi String   @default("Satış Fiyatı 1") @map("satis_fiyat_tipi")
  iskontoOrani   Decimal  @default(0) @map("iskonto_orani") @db.Decimal(5, 2)
  // Satış temsilcisi (kullanıcı adı)
  temsilci       String?
  // Çoklu şube kullanımında hesabın bağlı olduğu mağaza şubesi
  sube           String?
  muhasebeKodu   String?  @map("muhasebe_kodu")
  // Fatura bilgileri
  tcKimlik       String?  @map("tc_kimlik")
  vergiNo        String?  @map("vergi_no")
  vergiDairesi   String?  @map("vergi_dairesi")
  unvan          String?
  // Adres
  ulke           String?
  bolge          String?
  sehir          String?
  semt           String?
  adres          String?  @db.NVarChar(Max)
  // Pozitif = cari bizden alacaklı, negatif = bize borçlu.
  bakiye         Decimal  @default(0) @db.Decimal(14, 2)
  paraBirimi     String   @default("TL") @map("para_birimi")
  durum          String   @default("Aktif")
  not            String?  @db.NVarChar(Max)
  // Denetim izi (oturum altyapısı gelince kullanıcı id'leri dolar)
  createDate     DateTime @default(now()) @map("create_date")
  createUserId   String?  @map("create_user_id")
  updateDate     DateTime @updatedAt @map("update_date")
  updateUserId   String?  @map("update_user_id")

  islemler     CariIslem[]
  bankalar     CariBanka[]
  subeler      CariSube[]
  yetkililer   CariYetkili[]
  crmKayitlari CariCrm[]
  dokumanlar   CariDokuman[]

  @@map("cari")
}

// ── Cari banka hesapları ─────────────────────────────────────────────────
model CariBanka {
  id       Int     @id @default(autoincrement())
  cariId   String  @map("cari_id")
  bankaAdi String  @map("banka_adi")
  sube     String?
  iban     String?
  aciklama String?

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_banka")
}

// ── Cari şubeleri (karşı tarafın şubeleri/lokasyonları) ─────────────────
model CariSube {
  id       Int     @id @default(autoincrement())
  cariId   String  @map("cari_id")
  subeAdi  String  @map("sube_adi")
  yetkili  String?
  email    String?
  telefon  String?
  aciklama String?
  ulke     String?
  sehir    String?
  semt     String?
  adres    String? @db.NVarChar(Max)

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_sube")
}

// ── Cari yetkilileri (irtibat kişileri) ─────────────────────────────────
model CariYetkili {
  id       Int     @id @default(autoincrement())
  cariId   String  @map("cari_id")
  yetkili  String
  gorevi   String?
  email    String?
  telefon  String?
  subeAdi  String? @map("sube_adi")
  aciklama String?

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_yetkili")
}

// ── Cari CRM kayıtları (görüşme/ziyaret/teklif takibi) ──────────────────
model CariCrm {
  id       Int      @id @default(autoincrement())
  cariId   String   @map("cari_id")
  tarih    DateTime @db.Date
  personel String?
  // Telefon | Ziyaret | E-posta | Teklif | Toplantı | Diğer
  tip      String
  // Planlandı | Tamamlandı | İptal
  durum    String   @default("Planlandı")
  aciklama String?  @db.NVarChar(Max)

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_crm")
}

// ── Cari resim/dokümanları (URL tabanlı) ────────────────────────────────
model CariDokuman {
  id     Int    @id @default(autoincrement())
  cariId String @map("cari_id")
  ad     String
  url    String @db.NVarChar(Max)

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_dokuman")
}

// ── Cari işlem (tahsilat/ödeme/borç/alacak) ─────────────────────────────
model CariIslem {
  id       String   @id
  cariId   String   @map("cari_id")
  tarih    DateTime @db.Date
  tur      String
  tutar    Decimal  @db.Decimal(14, 2)
  belge    String?
  aciklama String   @db.NVarChar(Max)

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_islem")
}

// ── Rol (yetkilendirme; kullanıcıya ad ile bağlanır) ────────────────────
model Rol {
  id Int    @id @default(autoincrement())
  ad String @unique

  yetkiler RolYetki[]

  @@map("rol")
}

// ── Rol yetkisi (modül bazında erişim seviyesi) ─────────────────────────
model RolYetki {
  id       Int     @id @default(autoincrement())
  rolAd    String  @map("rol_ad")
  modul    String
  // Modül bazlı yetki bayrakları.
  isList   Boolean @default(false) @map("is_list")
  isAdd    Boolean @default(false) @map("is_add")
  isUpdate Boolean @default(false) @map("is_update")
  isDelete Boolean @default(false) @map("is_delete")

  rol Rol @relation(fields: [rolAd], references: [ad], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rolAd, modul])
  @@map("rol_yetki")
}

// ── Departman ───────────────────────────────────────────────────────────
model Departman {
  id Int    @id @default(autoincrement())
  ad String @unique

  @@map("departman")
}

// ── Kullanıcı yetkisi (kullanıcı bazında modül erişimi) ─────────────────
model KullaniciYetki {
  id          Int     @id @default(autoincrement())
  kullaniciId String  @map("kullanici_id")
  modul       String
  // Modül bazlı yetki bayrakları.
  isList      Boolean @default(false) @map("is_list")
  isAdd       Boolean @default(false) @map("is_add")
  isUpdate    Boolean @default(false) @map("is_update")
  isDelete    Boolean @default(false) @map("is_delete")

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kullaniciId, modul])
  @@map("kullanici_yetki")
}

// ── Yetki seti (tekrar kullanılabilir izin şablonu) ─────────────────────
model YetkiSeti {
  id       Int              @id @default(autoincrement())
  ad       String           @unique
  detaylar YetkiSetiDetay[]

  @@map("yetki_seti")
}

model YetkiSetiDetay {
  id       Int     @id @default(autoincrement())
  setId    Int     @map("set_id")
  modul    String
  isList   Boolean @default(false) @map("is_list")
  isAdd    Boolean @default(false) @map("is_add")
  isUpdate Boolean @default(false) @map("is_update")
  isDelete Boolean @default(false) @map("is_delete")

  set YetkiSeti @relation(fields: [setId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([setId, modul])
  @@map("yetki_seti_detay")
}

// ── Kullanıcı (giriş + yetkilendirme) ───────────────────────────────────
model Kullanici {
  id               String   @id
  kullaniciAdi     String   @unique @map("kullanici_adi")
  adSoyad          String   @map("ad_soyad")
  email            String?
  telefon          String?
  departman        String?
  // scrypt: "salt:hash" (hex) — düz şifre asla saklanmaz.
  sifreHash        String   @map("sifre_hash")
  rol              String   @default("Kullanıcı")
  durum            String   @default("Aktif")
  // Geçmiş tarihe işlem (kayıt) girebilme yetkisi
  eskiTarihliIslem Boolean  @default(false) @map("eski_tarihli_islem")
  olusturma        DateTime @db.Date

  yetkiler      KullaniciYetki[]
  cariYetkileri KullaniciCariYetki[]

  @@map("kullanici")
}

// ── Kullanıcı-Cari yetkisi (kayıt yoksa ikisi de AÇIK; satır = kısıtlama) ───
model KullaniciCariYetki {
  id          Int     @id @default(autoincrement())
  kullaniciId String  @map("kullanici_id")
  cariId      String  @map("cari_id")
  goruntule   Boolean @default(true) @map("goruntule")
  islemYap    Boolean @default(true) @map("islem_yap")

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kullaniciId, cariId])
  @@map("kullanici_cari_yetki")
}

// ── Liste ayarı (listeId → görünür ek kolonlar; yönetici belirler) ──────
model ListeAyar {
  id           Int    @id @default(autoincrement())
  listeId      String @unique @map("liste_id")
  kolonlarJson String @map("kolonlar_json")

  @@map("liste_ayar")
}

// ── Sistem parametresi (anahtar-değer; uygulama genel ayarları) ─────────
model SistemParametre {
  id       Int     @id @default(autoincrement())
  anahtar  String  @unique
  deger    String
  aciklama String?

  @@map("sistem_parametre")
}

// ── Malzeme Poşeti (hazır malzeme seti) ─────────────────────────────────
model Poset {
  id         String         @id
  ad         String
  aciklama   String?
  durum      String         @default("Aktif")
  malzemeler PosetMalzeme[]

  @@map("poset")
}

model PosetMalzeme {
  id        Int     @id @default(autoincrement())
  posetId   String  @map("poset_id")
  malzemeId String  @map("malzeme_id")
  miktar    Decimal @db.Decimal(14, 3)

  poset Poset @relation(fields: [posetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("poset_malzeme")
}

// ── Stok hareketi (giriş/çıkış/transfer; ürün veya malzeme) ─────────────
model StokHareket {
  id       String   @id
  tarih    DateTime @db.Date
  tur      String
  refTip   String   @map("ref_tip")
  refId    String   @map("ref_id")
  miktar   Decimal  @db.Decimal(14, 3)
  birim    String
  depo     String
  aciklama String   @db.NVarChar(Max)
  // Hareketi doğuran üretim emri (rezerv/tüketim izlenebilirliği)
  emirId   String?  @map("emir_id")
  // Tüketimin gerçekleştiği istasyon (mod 2 izlenebilirliği)
  istasyon String?

  @@map("stok_hareket")
}

// ── Tanımlamalar: stok grup ağacı (grup → alt grup → ...) ───────────────
model Grup {
  id    String  @id @default(cuid())
  ad    String
  kod   String
  ustId String? @map("ust_id")
  sira  Int     @default(0) // aynı üst altındaki sürükle-bırak sırası
  durum String  @default("Aktif")

  ust    Grup?  @relation("GrupHiyerarsi", fields: [ustId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  altlar Grup[] @relation("GrupHiyerarsi")

  @@map("grup")
}

// ── Tanımlamalar: düz tanımlar (marka/koleksiyon/renk/kumaş/birim) ───────
model Tanim {
  id    String @id @default(cuid())
  // "marka" | "koleksiyon" | "renk" | "kumas" | "birim"
  tip   String
  ad    String
  durum String @default("Aktif")

  @@unique([tip, ad])
  @@map("tanim")
}

// ── Döviz kurları (TCMB günlük) ─────────────────────────────────────────
model Kur {
  kod           String   @id // USD, EUR, GBP...
  ad            String
  birim         Int      @default(1)
  forexAlis     Decimal  @default(0) @map("forex_alis") @db.Decimal(14, 4)
  forexSatis    Decimal  @default(0) @map("forex_satis") @db.Decimal(14, 4)
  banknoteAlis  Decimal  @default(0) @map("banknote_alis") @db.Decimal(14, 4)
  banknoteSatis Decimal  @default(0) @map("banknote_satis") @db.Decimal(14, 4)
  tarih         String // TCMB bülten tarihi (gg.aa.yyyy)
  guncelleme    DateTime @updatedAt @map("guncelleme")

  @@map("kur")
}

// ── Tanımlamalar: üretim istasyonları (rota + 3D fabrika + bölüm) ───────
model Istasyon {
  id     String  @id // slug: kesim, bantlama, delik...
  ad     String
  sira   Int // üretim rotası sırası
  renk   String  @default("#737373")
  konumX Decimal @default(0) @map("konum_x") @db.Decimal(6, 2)
  konumZ Decimal @default(0) @map("konum_z") @db.Decimal(6, 2)
  konumG Decimal @default(4) @map("konum_g") @db.Decimal(6, 2)
  konumD Decimal @default(4) @map("konum_d") @db.Decimal(6, 2)
  durum  String  @default("Aktif")

  @@map("istasyon")
}

// ── Satın alma (tedarikçiden malzeme alışı) ─────────────────────────────
// Kaydedildiğinde: malzeme stokları artar + stok hareketi (Giriş) yazılır +
// cariye Alacak işlemi düşer. Bu yüzden alış kaydı silinemez (v1).
model Alis {
  id       String   @id
  // Tedarikçi fiş başında değil satır bazında; karışıksa null + cariAd "Muhtelif".
  cariId   String?  @map("cari_id")
  cariAd   String   @map("cari_ad")
  tarih    DateTime @db.Date
  depo     String
  belgeNo  String?  @map("belge_no")
  aciklama String?  @db.NVarChar(Max)
  toplam   Decimal  @default(0) @db.Decimal(14, 2)

  satirlar AlisSatiri[]

  @@map("alis")
}

model AlisSatiri {
  id         Int     @id @default(autoincrement())
  alisId     String  @map("alis_id")
  // Bu satırın alındığı tedarikçi (satır bazında firma).
  cariId     String  @default("") @map("cari_id")
  cariAd     String  @default("") @map("cari_ad")
  malzemeId  String  @map("malzeme_id")
  malzemeAd  String  @map("malzeme_ad")
  miktar     Decimal @db.Decimal(14, 3)
  birim      String
  birimFiyat Decimal @map("birim_fiyat") @db.Decimal(14, 2)

  alis Alis @relation(fields: [alisId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("alis_satiri")
}

// ── Stok kartı (birleşik: hammadde / yarı mamül / mamül / hizmet) ────────
// Kartın sahibi bu tablodur. Mevcut akışlar bozulmasın diye malzeme ve
// model tabloları AYNI id ile senkron ayna olarak tutulur (stokKaydet):
//   Hammadde / Yarı Mamül → malzeme aynası, Mamül → model aynası.
// Stok MİKTARI ledger'a aittir ve ayna tablolarda yaşar; kart okur.
model Stok {
  id             String   @id
  // Kullanıcı kodu (boşsa id gösterilir)
  kod            String?
  ad             String
  tur            String?
  cins           String?
  // Hammadde | Yarı Mamül | Mamül | Hizmet
  grup           String
  // Grup ağacından (Tanımlamalar → Gruplar) adlar
  altGrup        String?  @map("alt_grup")
  detayGrup      String?  @map("detay_grup")
  kategori       String?
  marka          String?
  model          String?
  stokBirimi     String   @default("adet") @map("stok_birimi")
  puan           Decimal? @db.Decimal(10, 2)
  yukseklik      Decimal? @db.Decimal(10, 2)
  genislik       Decimal? @db.Decimal(10, 2)
  boy            Decimal? @db.Decimal(10, 2)
  agirlik        Decimal? @db.Decimal(10, 3)
  minSiparis     Decimal? @map("min_siparis") @db.Decimal(14, 3)
  minStok        Decimal? @map("min_stok") @db.Decimal(14, 3)
  maxStok        Decimal? @map("max_stok") @db.Decimal(14, 3)
  muhasebeKodu   String?  @map("muhasebe_kodu")
  // Reçete havuzdan seçilir (parca.id); rota şimdilik sabit fabrika rotası
  receteParcaId  String?  @map("recete_parca_id")
  rota           String?  @default("fabrika")
  // Varsayılan üretici (detaylı liste StokUretici'de)
  ureticiCariId  String?  @map("uretici_cari_id")
  ureticiKodu    String?  @map("uretici_kodu")
  bolum          String?
  renkKodu       String?  @map("renk_kodu")
  barkod         String?
  aciklama       String?  @db.NVarChar(Max)
  durum          String   @default("Aktif")
  // Eldeki miktar özeti (ledger yetkili; malzeme.stok/model.stok yerine)
  stokMiktar     Decimal  @default(0) @map("stok_miktar") @db.Decimal(14, 3)
  // Mamul: renk/kumaş varyantları + görsel galerisi (model'den taşındı)
  varyantlarJson String?  @map("varyantlar") @db.NVarChar(Max)
  gorsel         String?  @db.NVarChar(Max)
  gorsellerJson  String?  @map("gorseller") @db.NVarChar(Max)
  createDate     DateTime @default(now()) @map("create_date")
  createUserId   String?  @map("create_user_id")
  updateDate     DateTime @updatedAt @map("update_date")
  updateUserId   String?  @map("update_user_id")
  // Fiyatlar (birimler döviz: TL/USD/EUR)
  maliyetFiyati  Decimal  @default(0) @map("maliyet_fiyati") @db.Decimal(14, 2)
  maliyetBirimi  String   @default("TL") @map("maliyet_birimi")
  satisFiyat1    Decimal  @default(0) @map("satis_fiyat1") @db.Decimal(14, 2)
  satisBirim1    String   @default("TL") @map("satis_birim1")
  satisFiyat2    Decimal  @default(0) @map("satis_fiyat2") @db.Decimal(14, 2)
  satisBirim2    String   @default("TL") @map("satis_birim2")
  satisFiyat3    Decimal  @default(0) @map("satis_fiyat3") @db.Decimal(14, 2)
  satisBirim3    String   @default("TL") @map("satis_birim3")
  satisFiyat4    Decimal  @default(0) @map("satis_fiyat4") @db.Decimal(14, 2)
  satisBirim4    String   @default("TL") @map("satis_birim4")
  satisFiyat5    Decimal  @default(0) @map("satis_fiyat5") @db.Decimal(14, 2)
  satisBirim5    String   @default("TL") @map("satis_birim5")

  ureticiler      StokUretici[]
  musteriler      StokMusteri[]
  dokumanlar      StokDokuman[]
  // Birleşme: reçete bileşeni / mamul BOM / üretim emri artık Stok'a bağlı
  receteSatirlari ReceteSatiri[]
  modelParcalar   ModelParca[]
  uretimEmirleri  UretimEmri[]

  @@map("stok")
}

// ── Stok kartı üreticileri (tedarikçi bazlı kod/fiyat/termin) ───────────
model StokUretici {
  id          Int      @id @default(autoincrement())
  stokId      String   @map("stok_id")
  cariId      String   @map("cari_id")
  cariAd      String   @map("cari_ad")
  ureticiKodu String?  @map("uretici_kodu")
  fiyat       Decimal  @default(0) @db.Decimal(14, 2)
  doviz       String   @default("TL")
  minSiparis  Decimal? @map("min_siparis") @db.Decimal(14, 3)
  tedarikGun  Int?     @map("tedarik_gun")

  stok Stok @relation(fields: [stokId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("stok_uretici")
}

// ── Stok kartı müşterileri (müşteri bazlı kod/fiyat/iskonto) ────────────
model StokMusteri {
  id           Int      @id @default(autoincrement())
  stokId       String   @map("stok_id")
  cariId       String   @map("cari_id")
  cariAd       String   @map("cari_ad")
  musteriKodu  String?  @map("musteri_kodu")
  minSiparis   Decimal? @map("min_siparis") @db.Decimal(14, 3)
  fiyat        Decimal  @default(0) @db.Decimal(14, 2)
  doviz        String   @default("TL")
  iskontoOrani Decimal  @default(0) @map("iskonto_orani") @db.Decimal(5, 2)

  stok Stok @relation(fields: [stokId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("stok_musteri")
}

// ── Stok kartı resim/dokümanları ────────────────────────────────────────
model StokDokuman {
  id     Int    @id @default(autoincrement())
  stokId String @map("stok_id")
  ad     String
  url    String @db.NVarChar(Max)
  // Ürün Resmi | Teknik Resim | PDF | Kalite Belgesi | Video | Diğer
  tip    String @default("Diğer")

  stok Stok @relation(fields: [stokId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("stok_dokuman")
}
