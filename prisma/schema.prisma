// MobilyumPro veritabanı şeması (SQL Server + Prisma).
// Alan adları uygulamadaki domain modeliyle (Türkçe) birebir tutulur.
// ID'ler insan-okunur kodlar (URN-1001, MLZ-1001 ...).
//
// Not: SQL Server'da Postgres'teki enum/array/jsonb yok:
//  - enum'lar   → String (uygulama katmanı domain tipleriyle daraltır)
//  - text[]     → JSON string (gorsellerJson)
//  - jsonb      → JSON string (varyantlarJson)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── Model (eski: ürün) ──────────────────────────────────────────────────
model Model {
  id            String  @id @map("id")
  ad            String
  kategori      String
  fiyat         Decimal @default(0) @db.Decimal(14, 2)
  stok          Int     @default(0)
  durum         String  @default("Aktif")
  gorsel        String? @db.NVarChar(Max)
  marka         String?
  barkod        String?
  agirlik       Decimal? @db.Decimal(14, 3)
  minStok       Int?    @map("min_stok")
  gorsellerJson String? @map("gorseller") @db.NVarChar(Max)
  varyantlarJson String? @map("varyantlar") @db.NVarChar(Max)

  parcalar      ModelParca[]
  uretimEmirleri UretimEmri[]

  @@map("model")
}

// ── Parça (BOM kataloğu — kullanıcıya "Reçete" olarak sunulur) ──────────
model Parca {
  id       String  @id
  ad       String
  kategori String
  aciklama String? @db.NVarChar(Max)
  durum    String  @default("Aktif")

  recete       ReceteSatiri[]   @relation("ParcaRecete")
  altParcaOlan ReceteSatiri[]   @relation("AltParca")
  modeller     ModelParca[]
  versiyonlar  ReceteVersiyon[]

  @@map("parca")
}

// ── Reçete versiyonu (her kayıtta anlık kopya; tam geçmiş) ──────────────
model ReceteVersiyon {
  id         Int      @id @default(autoincrement())
  parcaId    String   @map("parca_id")
  versiyonNo Int      @map("versiyon_no")
  tarih      DateTime @default(now())
  aciklama   String?  @db.NVarChar(Max)
  // Satırların anlık kopyası: [{tip, ref, miktar}] (JSON)
  satirlarJson String @map("satirlar") @db.NVarChar(Max)

  parca Parca @relation(fields: [parcaId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([parcaId, versiyonNo])
  @@map("recete_versiyon")
}

// ── Malzeme (hammadde / yarı mamul / yardımcı) ──────────────────────────
model Malzeme {
  id         String  @id
  ad         String
  tip        String
  birim      String
  stok       Decimal @default(0) @db.Decimal(14, 3)
  birimFiyat Decimal @default(0) @map("birim_fiyat") @db.Decimal(14, 2)
  tedarikci  String?
  durum      String  @default("Aktif")

  receteSatirlari ReceteSatiri[]

  @@map("malzeme")
}

// ── Reçete satırı (parçanın bileşenleri: malzeme veya alt-parça) ────────
model ReceteSatiri {
  id         Int     @id @default(autoincrement())
  parcaId    String  @map("parca_id")
  tip        String
  malzemeId  String? @map("malzeme_id")
  altParcaId String? @map("alt_parca_id")
  miktar     Decimal @db.Decimal(14, 3)
  // Fire payı (%): brüt ihtiyaç = miktar × (1 + fire/100)
  fire       Decimal @default(0) @db.Decimal(5, 2)
  // Bileşenin tüketildiği istasyon (fabrika rotası slug'ı; null → ilk istasyon)
  istasyon   String?

  parca    Parca    @relation("ParcaRecete", fields: [parcaId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  malzeme  Malzeme? @relation(fields: [malzemeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  altParca Parca?   @relation("AltParca", fields: [altParcaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("recete_satiri")
}

// ── Model-Parça (modelin BOM bağlantısı) ────────────────────────────────
model ModelParca {
  id      Int     @id @default(autoincrement())
  modelId String  @map("model_id")
  parcaId String  @map("parca_id")
  miktar  Decimal @db.Decimal(14, 3)

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parca Parca @relation(fields: [parcaId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("model_parca")
}

// ── Depo ────────────────────────────────────────────────────────────────
model Depo {
  id       String @id
  ad       String
  sehir    String
  kapasite Int    @default(0)
  doluluk  Int    @default(0)
  durum    String @default("Aktif")

  @@map("depo")
}

// ── Müşteri ─────────────────────────────────────────────────────────────
model Musteri {
  id    String  @id
  ad    String
  email String?
  sehir String?

  siparisler Siparis[]

  @@map("musteri")
}

// ── Sipariş ─────────────────────────────────────────────────────────────
model Siparis {
  id        String   @id
  musteriId String?  @map("musteri_id")
  musteriAd String   @map("musteri_ad") // anlık ad (görüntü/tarihsel)
  tarih     DateTime @db.Date
  tutar     Decimal  @default(0) @db.Decimal(14, 2)
  durum     String   @default("Beklemede")
  urunAdedi Int      @default(1) @map("urun_adedi")

  musteri Musteri? @relation(fields: [musteriId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("siparis")
}

// ── Üretim emri ─────────────────────────────────────────────────────────
model UretimEmri {
  id            String    @id
  modelId       String    @map("model_id")
  modelAd       String    @map("model_ad")
  adet          Int       @default(1)
  durum         String    @default("Planlandı")
  oncelik       String?   @default("Normal")
  olusturma     DateTime  @db.Date
  termin        DateTime? @db.Date
  kaynakSiparis String?   @map("kaynak_siparis")
  musteri       String?
  hedefDepo     String?   @map("hedef_depo")
  not           String?   @db.NVarChar(Max)

  model Model @relation(fields: [modelId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  adimlar UretimEmriAdim[]

  @@map("uretim_emri")
}

// ── Üretim emri adımı (fabrika istasyon rotası) ─────────────────────────
model UretimEmriAdim {
  id        Int       @id @default(autoincrement())
  emirId    String    @map("emir_id")
  // İstasyon slug'ı: kesim | bantlama | delik | montaj | paketleme | sevkiyat
  istasyon  String
  sira      Int
  // "Bekliyor" | "İşleniyor" | "Tamamlandı"
  durum     String    @default("Bekliyor")
  baslangic DateTime?
  bitis     DateTime?

  emir UretimEmri @relation(fields: [emirId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([emirId, sira])
  @@map("uretim_emri_adim")
}

// ── Cari (müşteri/tedarikçi hesabı) ─────────────────────────────────────
model Cari {
  id           String  @id
  ad           String
  tip          String
  sinif        String
  vergiNo      String? @map("vergi_no")
  vergiDairesi String? @map("vergi_dairesi")
  telefon      String?
  email        String?
  adres        String? @db.NVarChar(Max)
  sehir        String?
  // Pozitif = cari bizden alacaklı, negatif = bize borçlu.
  bakiye       Decimal @default(0) @db.Decimal(14, 2)
  paraBirimi   String  @default("TL") @map("para_birimi")
  durum        String  @default("Aktif")
  not          String? @db.NVarChar(Max)

  islemler CariIslem[]

  @@map("cari")
}

// ── Cari işlem (tahsilat/ödeme/borç/alacak) ─────────────────────────────
model CariIslem {
  id       String   @id
  cariId   String   @map("cari_id")
  tarih    DateTime @db.Date
  tur      String
  tutar    Decimal  @db.Decimal(14, 2)
  belge    String?
  aciklama String   @db.NVarChar(Max)

  cari Cari @relation(fields: [cariId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("cari_islem")
}

// ── Rol (yetkilendirme; kullanıcıya ad ile bağlanır) ────────────────────
model Rol {
  id Int    @id @default(autoincrement())
  ad String @unique

  yetkiler RolYetki[]

  @@map("rol")
}

// ── Rol yetkisi (modül bazında erişim seviyesi) ─────────────────────────
model RolYetki {
  id    Int    @id @default(autoincrement())
  rolAd String @map("rol_ad")
  modul String
  // Modül bazlı yetki bayrakları.
  isList   Boolean @default(false) @map("is_list")
  isAdd    Boolean @default(false) @map("is_add")
  isUpdate Boolean @default(false) @map("is_update")
  isDelete Boolean @default(false) @map("is_delete")

  rol Rol @relation(fields: [rolAd], references: [ad], onDelete: Cascade, onUpdate: NoAction)

  @@unique([rolAd, modul])
  @@map("rol_yetki")
}

// ── Departman ───────────────────────────────────────────────────────────
model Departman {
  id Int    @id @default(autoincrement())
  ad String @unique

  @@map("departman")
}

// ── Kullanıcı yetkisi (kullanıcı bazında modül erişimi) ─────────────────
model KullaniciYetki {
  id          Int    @id @default(autoincrement())
  kullaniciId String @map("kullanici_id")
  modul       String
  // Modül bazlı yetki bayrakları.
  isList   Boolean @default(false) @map("is_list")
  isAdd    Boolean @default(false) @map("is_add")
  isUpdate Boolean @default(false) @map("is_update")
  isDelete Boolean @default(false) @map("is_delete")

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kullaniciId, modul])
  @@map("kullanici_yetki")
}

// ── Yetki seti (tekrar kullanılabilir izin şablonu) ─────────────────────
model YetkiSeti {
  id       Int              @id @default(autoincrement())
  ad       String           @unique
  detaylar YetkiSetiDetay[]

  @@map("yetki_seti")
}

model YetkiSetiDetay {
  id    Int    @id @default(autoincrement())
  setId Int    @map("set_id")
  modul String
  isList   Boolean @default(false) @map("is_list")
  isAdd    Boolean @default(false) @map("is_add")
  isUpdate Boolean @default(false) @map("is_update")
  isDelete Boolean @default(false) @map("is_delete")

  set YetkiSeti @relation(fields: [setId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([setId, modul])
  @@map("yetki_seti_detay")
}

// ── Kullanıcı (giriş + yetkilendirme) ───────────────────────────────────
model Kullanici {
  id           String   @id
  kullaniciAdi String   @unique @map("kullanici_adi")
  adSoyad      String   @map("ad_soyad")
  email        String?
  telefon      String?
  departman    String?
  // scrypt: "salt:hash" (hex) — düz şifre asla saklanmaz.
  sifreHash    String   @map("sifre_hash")
  rol          String   @default("Kullanıcı")
  durum        String   @default("Aktif")
  // Geçmiş tarihe işlem (kayıt) girebilme yetkisi
  eskiTarihliIslem Boolean @default(false) @map("eski_tarihli_islem")
  olusturma    DateTime @db.Date

  yetkiler     KullaniciYetki[]
  cariYetkileri KullaniciCariYetki[]

  @@map("kullanici")
}

// ── Kullanıcı-Cari yetkisi (kayıt yoksa ikisi de AÇIK; satır = kısıtlama) ───
model KullaniciCariYetki {
  id          Int     @id @default(autoincrement())
  kullaniciId String  @map("kullanici_id")
  cariId      String  @map("cari_id")
  goruntule   Boolean @default(true) @map("goruntule")
  islemYap    Boolean @default(true) @map("islem_yap")

  kullanici Kullanici @relation(fields: [kullaniciId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([kullaniciId, cariId])
  @@map("kullanici_cari_yetki")
}

// ── Liste ayarı (listeId → görünür ek kolonlar; yönetici belirler) ──────
model ListeAyar {
  id           Int    @id @default(autoincrement())
  listeId      String @unique @map("liste_id")
  kolonlarJson String @map("kolonlar_json")

  @@map("liste_ayar")
}

// ── Sistem parametresi (anahtar-değer; uygulama genel ayarları) ─────────
model SistemParametre {
  id       Int     @id @default(autoincrement())
  anahtar  String  @unique
  deger    String
  aciklama String?

  @@map("sistem_parametre")
}

// ── Malzeme Poşeti (hazır malzeme seti) ─────────────────────────────────
model Poset {
  id        String         @id
  ad        String
  aciklama  String?
  durum     String         @default("Aktif")
  malzemeler PosetMalzeme[]

  @@map("poset")
}

model PosetMalzeme {
  id        Int     @id @default(autoincrement())
  posetId   String  @map("poset_id")
  malzemeId String  @map("malzeme_id")
  miktar    Decimal @db.Decimal(14, 3)

  poset Poset @relation(fields: [posetId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("poset_malzeme")
}

// ── Stok hareketi (giriş/çıkış/transfer; ürün veya malzeme) ─────────────
model StokHareket {
  id       String   @id
  tarih    DateTime @db.Date
  tur      String
  refTip   String   @map("ref_tip")
  refId    String   @map("ref_id")
  miktar   Decimal  @db.Decimal(14, 3)
  birim    String
  depo     String
  aciklama String   @db.NVarChar(Max)
  // Hareketi doğuran üretim emri (rezerv/tüketim izlenebilirliği)
  emirId   String?  @map("emir_id")
  // Tüketimin gerçekleştiği istasyon (mod 2 izlenebilirliği)
  istasyon String?

  @@map("stok_hareket")
}
