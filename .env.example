# SQL Server bağlantısı (fabrika içi LAN sunucusu: app ile aynı makine)
# Format (Prisma sqlserver): sqlserver://HOST:PORT;database=VERITABANI;user=KULLANICI;password={PAROLA};trustServerCertificate=true;encrypt=true
DATABASE_URL="sqlserver://localhost:1433;database=mobilyumpro;user=sa;password={PAROLA};trustServerCertificate=true;encrypt=true"

# Oturum çerezini imzalar — her kurulumda kendi rastgele değerini üret.
OTURUM_ANAHTARI=

# ── Güncelleme sistemi (yalnız fabrika sunucusunda) ────────────────────
# Sürümlerin çıktığı dal. Müşteri sunucusu bu dalın ETİKETLERİNİ takip eder.
GUNCELLE_DAL=main

# Build başarılı olduktan sonra servisi yeniden başlatan komut.
# scripts/servis-kur.ps1 kurulum sonunda doğru değeri ekrana yazar.
#   NSSM ile      : nssm restart MobilyumPro
#   Görev ile     : schtasks /End /TN MobilyumPro-Sunucu & schtasks /Run /TN MobilyumPro-Sunucu
GUNCELLE_RESTART_KOMUT=

# Migrate ÖNCESİ çalışan DB yedek komutu. AYARLANMASI ŞARTTIR:
# şema değişikliği geri alınamaz — rollback kodu ve build'i döndürür ama
# migrate uygulanmışsa veriyi ancak bu yedek kurtarır.
# Örn: sqlcmd -S localhost -E -Q "BACKUP DATABASE [mobilyumpro] TO DISK='D:\yedek\mp.bak' WITH INIT"
GUNCELLE_DB_YEDEK_KOMUT=
